{
  "manifest_version": 3,
  "name": "QikaCode",
  "version": "1.1.0",
  "description": "教学演示：通过「Chrome 扩展 + Native Messaging + CDP」接管本机已运行浏览器并操作页面的原理。",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "activeTab",
    "scripting",
    "alarms",
    "storage"
  ],
  "action": {
    "default_title": "browser-ctl：点一下确保连接"
  },
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
